# ===== قاعدة البيانات =====
# مثال: postgresql://postgres:postgres@localhost:5432/universal_ai_agent
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/universal_ai_agent"

# ===== الخادم =====
PORT=4000
JWT_SECRET="change-me-in-production"
# مفتاح رئيسي مستقل لتشفير أسرار العملاء في قاعدة البيانات (AES-256-GCM).
# مهم جدًا: ثبّته بقيمة عشوائية قوية واحتفظ بها — فقده يعني فقدان الأسرار المشفرة.
SECRET_KEY="generate-strong-random-value"
CORS_ORIGIN="http://localhost:5173"
DEV_AUTH_ENABLED="true"          # تسجيل دخول تطويري (admin@demo.local)

# ===== محرك الصوت rapidaai =====
RAPIDA_ASSISTANT_GRPC_URL="localhost:9007"
RAPIDA_ASSISTANT_ID=1            # معرّف الوكيل على خادم rapida
RAPIDA_ASSISTANT_VERSION="1.0.0"

# ===== Deepgram (STT) =====
DEEPGRAM_API_KEY=""

# ===== OpenAI (LLM + Embeddings) =====
OPENAI_API_KEY=""
OPENAI_LLM_MODEL="gpt-4o-mini"
OPENAI_EMBED_MODEL="text-embedding-3-small"

# ===== Azure TTS =====
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"

# ===== WhatsApp — المحرك الرسمي (Meta Cloud API) =====
META_GRAPH_VERSION="v21.0"
META_WEBHOOK_VERIFY_TOKEN="verify-me"

# ===== تخزين الملفات (TTS cache / المستندات / جلسات الواتساب) =====
STORAGE_DIR="./storage"
